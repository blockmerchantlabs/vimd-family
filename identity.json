{
  "name": "VIMD Family",
  "edition": 2,
  "reference": "https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/visualidentity.md",
  "useInAJob": "Use the visual identity package at https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/visualidentity.md for every colour, font, layout rule and the logo.",
  "defaultTheme": "slate",
  "themes": [
    "slate",
    "stone",
    "white",
    "black"
  ],
  "tokens": "https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/tokens.css",
  "colors": "https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/colors.json",
  "type": {
    "family": "IBM Plex Mono",
    "weights": [
      400,
      500,
      600
    ],
    "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "sizes": {
      "label": 11,
      "body": 13,
      "h2": 18,
      "h1": 28
    },
    "labelTracking": "0.06em"
  },
  "layout": {
    "rule": "1.5px solid var(--ink)",
    "radius": 0,
    "gutter": "clamp(16px,4vw,34px)",
    "maxWidth": 1100,
    "button": "outlined pill, 40px tall",
    "shadows": false,
    "gradients": false
  },
  "logo": {
    "familyBase": "https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/assets/family-base-pepe.png",
    "familyBaseJob": "https://explorer.imd.fun/jobs/0de5b3c1-0435-4ef3-9158-00231d3cde02",
    "familyBaseArtifact": "https://api.imd.fun/artifacts/61c6de390433a37b6c800799f11d5082150684efd972753db9e760b4e62f32de",
    "example": "https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/assets/example-investor-pepe.png",
    "exampleJob": "https://explorer.imd.fun/jobs/de4618d8-66ce-42b2-ba9b-2f13a8e88ce9",
    "parentImdOnly": "https://raw.githubusercontent.com/blockmerchantlabs/vimd-family/v3/assets/imd-coin-pepe-800.png",
    "changeable": [
      "background",
      "skin",
      "outfit",
      "eyes",
      "hat or hair",
      "moustache or accessory",
      "frame",
      "colours"
    ],
    "fixed": [
      "face",
      "pose",
      "expression"
    ]
  },
  "showcase": "https://blockmerchantlabs.github.io/vimd-family/"
}